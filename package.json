{
  "name": "offline-review",
  "displayName": "Offline Review",
  "description": "Review diffs and annotate workspace code locally with offline inline comments — no remote needed.",
  "version": "0.2.6",
  "publisher": "Daedie",
  "author": "Daedie",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daedie-git/offline-review"
  },
  "homepage": "https://github.com/Daedie-git/offline-review#readme",
  "bugs": {
    "url": "https://github.com/Daedie-git/offline-review/issues"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "offline review",
    "local review",
    "local code review",
    "code review",
    "agent review",
    "agent code review",
    "diff",
    "comments",
    "offline",
    "review",
    "local"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onView:localPrReview.branchSelector",
    "onView:localPrReview.changedFiles",
    "onView:localPrReview.localPrs",
    "onView:localPrReview.localComments",
    "onView:localPrReview.codeComments"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "localPrReview.unresolvedCommentForeground",
        "description": "Color for files with unresolved review comments",
        "defaults": {
          "dark": "#e2c08d",
          "light": "#b58900",
          "highContrast": "#e2c08d",
          "highContrastLight": "#b58900"
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "localPrReview_getComments",
        "displayName": "Get Offline Review Comments",
        "toolReferenceName": "offlineReviewComments",
        "modelDescription": "Retrieves local code review comments stored by the 'Offline Review' VS Code extension. This is NOT related to GitHub Pull Requests or any remote service. These are offline, local-only review comments that users create in diff views within VS Code. Call this tool when the user mentions: local comments, local review, review comments, self-review, check comments, local PR comments. The tool auto-detects the active review from the current git branch. If no review exists, tell the user to create one using the Offline Review sidebar. Do NOT search the filesystem or run terminal commands to find comments — this tool is the ONLY way to access local review comments.",
        "icon": "$(comment-discussion)",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Optional workspace-relative file path to filter comments for a specific file. Example: 'src/main.py'"
            },
            "state": {
              "type": "string",
              "enum": [
                "resolved",
                "unresolved"
              ],
              "description": "Optional filter by comment state: 'resolved' or 'unresolved'. Omit to get all comments."
            }
          }
        }
      },
      {
        "name": "localPrReview_getCodeComments",
        "displayName": "Get Workspace Code Comments",
        "toolReferenceName": "offlineCodeComments",
        "modelDescription": "Retrieves workspace code comments stored locally by Offline Review. These comments are authored in ordinary editors and are independent of diff/review comments and active reviews. Use this tool when the user asks about workspace comments, code comments, or comments to address. It reports exact workspace-relative paths, source anchors, and missing/stale status. Do not substitute #offlineReviewComments.",
        "icon": "$(comment-discussion)",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Optional exact normalized workspace-relative path, for example 'src/main.ts'."
            },
            "state": {
              "type": "string",
              "enum": [
                "resolved",
                "unresolved"
              ],
              "description": "Optional exact thread state filter."
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localPrReview",
          "title": "Offline Review",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "localPrReview": [
        {
          "type": "webview",
          "id": "localPrReview.branchSelector",
          "name": "Branch Selector"
        },
        {
          "id": "localPrReview.changedFiles",
          "name": "Changed Files"
        },
        {
          "id": "localPrReview.localPrs",
          "name": "Reviews"
        },
        {
          "id": "localPrReview.localComments",
          "name": "Review Comments"
        },
        {
          "id": "localPrReview.codeComments",
          "name": "Code Comments"
        }
      ]
    },
    "commands": [
      {
        "command": "localPrReview.refreshComments",
        "title": "Refresh Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.refreshPrs",
        "title": "Refresh PRs",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.createReview",
        "title": "Create Review",
        "icon": "$(add)"
      },
      {
        "command": "localPrReview.reviewUncommitted",
        "title": "Review Uncommitted Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "localPrReview.reviewActiveBranch",
        "title": "Review Active Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "localPrReview.deleteReview",
        "title": "Delete Review",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.clearActiveReview",
        "title": "Clear Active Review",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.clearAllReviews",
        "title": "Clear All Reviews",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.activateReview",
        "title": "Activate Review"
      },
      {
        "command": "localPrReview.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "localPrReview.refreshFiles",
        "title": "Refresh Changed Files",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "localPrReview.unresolveThread",
        "title": "Unresolve",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "localPrReview.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "localPrReview.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.addComment",
        "title": "Add Comment"
      },
      {
        "command": "localPrReview.replyComment",
        "title": "Reply"
      },
      {
        "command": "localPrReview.saveComment",
        "title": "Save"
      },
      {
        "command": "localPrReview.cancelComment",
        "title": "Cancel"
      },
      {
        "command": "localPrReview.deleteCommentsFile",
        "title": "Delete Comments",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localPrReview.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "localPrReview.openAllDiffs",
        "title": "Open All Diffs",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "localPrReview.suggestChange",
        "title": "Suggest a Change",
        "icon": "$(lightbulb)"
      },
      {
        "command": "localPrReview.refreshCodeComments",
        "title": "Refresh Code Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.clearCodeComments",
        "title": "Clear Workspace Comments",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.openCodeComment",
        "title": "Open Code Comment",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localPrReview.addCodeComment",
        "title": "Add Code Comment"
      },
      {
        "command": "localPrReview.replyCodeComment",
        "title": "Reply"
      },
      {
        "command": "localPrReview.saveCodeComment",
        "title": "Save"
      },
      {
        "command": "localPrReview.cancelCodeComment",
        "title": "Cancel"
      },
      {
        "command": "localPrReview.editCodeComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "localPrReview.deleteCodeComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.resolveCodeComment",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "localPrReview.unresolveCodeComment",
        "title": "Unresolve",
        "icon": "$(issue-reopened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localPrReview.openAllDiffs",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "localPrReview.expandAll",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@2"
        },
        {
          "command": "localPrReview.refreshFiles",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@3"
        },
        {
          "command": "localPrReview.refreshPrs",
          "when": "view == localPrReview.localPrs",
          "group": "navigation@1"
        },
        {
          "command": "localPrReview.clearAllReviews",
          "when": "view == localPrReview.localPrs",
          "group": "navigation@2"
        },
        {
          "command": "localPrReview.refreshComments",
          "when": "view == localPrReview.localComments",
          "group": "navigation"
        },
        {
          "command": "localPrReview.refreshCodeComments",
          "when": "view == localPrReview.codeComments",
          "group": "navigation@1"
        },
        {
          "command": "localPrReview.clearCodeComments",
          "when": "view == localPrReview.codeComments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "localPrReview.deleteReview",
          "when": "view == localPrReview.localPrs",
          "group": "inline"
        },
        {
          "command": "localPrReview.deleteCommentsFile",
          "when": "view == localPrReview.localComments && viewItem == commentFile",
          "group": "inline"
        },
        {
          "command": "localPrReview.openFile",
          "when": "view == localPrReview.changedFiles && viewItem == fileChange",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localPrReview.addComment",
          "group": "inline",
          "when": "commentController == localPrReview && commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.replyComment",
          "group": "inline@1",
          "when": "commentController == localPrReview && !commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.cancelComment",
          "group": "inline@2",
          "when": "commentController == localPrReview && commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.suggestChange",
          "group": "inline@3",
          "when": "commentController == localPrReview && !commentThreadIsEmpty && commentThread == unresolved"
        },
        {
          "command": "localPrReview.addCodeComment",
          "group": "inline",
          "when": "commentController == localCodeComments && commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.replyCodeComment",
          "group": "inline@1",
          "when": "commentController == localCodeComments && !commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.cancelCodeComment",
          "group": "inline@2",
          "when": "commentController == localCodeComments && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "localPrReview.editComment",
          "group": "inline@1",
          "when": "commentController == localPrReview && comment == canEdit"
        },
        {
          "command": "localPrReview.deleteComment",
          "group": "inline@2",
          "when": "commentController == localPrReview && comment == canEdit"
        },
        {
          "command": "localPrReview.editCodeComment",
          "group": "inline@1",
          "when": "commentController == localCodeComments && comment == canEdit"
        },
        {
          "command": "localPrReview.deleteCodeComment",
          "group": "inline@2",
          "when": "commentController == localCodeComments && comment == canEdit"
        }
      ],
      "comments/comment/context": [
        {
          "command": "localPrReview.saveComment",
          "group": "inline@1",
          "when": "commentController == localPrReview"
        },
        {
          "command": "localPrReview.cancelComment",
          "group": "inline@2",
          "when": "commentController == localPrReview"
        },
        {
          "command": "localPrReview.saveCodeComment",
          "group": "inline@1",
          "when": "commentController == localCodeComments"
        },
        {
          "command": "localPrReview.cancelCodeComment",
          "group": "inline@2",
          "when": "commentController == localCodeComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "localPrReview.resolveThread",
          "group": "inline@1",
          "when": "commentController == localPrReview && commentThread == unresolved"
        },
        {
          "command": "localPrReview.unresolveThread",
          "group": "inline@1",
          "when": "commentController == localPrReview && commentThread == resolved"
        },
        {
          "command": "localPrReview.resolveCodeComment",
          "group": "inline@1",
          "when": "commentController == localCodeComments && commentThread == unresolved"
        },
        {
          "command": "localPrReview.unresolveCodeComment",
          "group": "inline@1",
          "when": "commentController == localCodeComments && commentThread == resolved"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "build": "npm run clean && npm run compile",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "vscode:prepublish": "npm run check",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "uuid": "^11.1.1"
  }
}
